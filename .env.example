# Exemplo de configuração de variáveis de ambiente
# Copie este arquivo para .env e preencha com os valores correspondentes

# Em desenvolvimento, deixe vazio para usar o proxy local do Vite (gateway em localhost:80).
# Se o frontend estiver em outra origem em produção, configure a URL pública do gateway
# e permita essa origem na configuração de CORS do backend.

# URL base da API
VITE_API_URL=http://localhost:8080

# Visualizar todas as rotas sem login
VITE_DEV_AUTH_BYPASS=false

# Ambiente da aplicação
VITE_AMBIENTE=desenvolvimento

# Dados de teste somente em desenvolvimento
VITE_USE_MOCKS=false
