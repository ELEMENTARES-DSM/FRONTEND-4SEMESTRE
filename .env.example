# URL base da API. Com "/", o servidor do Vite encaminha /auth, /usuarios,
# /estacoes e /alertas para o gateway do backend (porta 80), sem CORS.
VITE_API_URL=/

# Visualizar todas as rotas sem login
VITE_DEV_AUTH_BYPASS=false

# Ambiente da aplicação
VITE_AMBIENTE=desenvolvimento

# Dados de teste somente em desenvolvimento (true usa o adaptador de mock)
VITE_USE_MOCKS=false
