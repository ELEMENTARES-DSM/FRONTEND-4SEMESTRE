# URL base da API
VITE_API_URL=http://localhost:8080

# Alternar entre dados mockados (true) e API real (false)
VITE_USE_MOCK=true
# Visualizar todas as rotas sem login
VITE_DEV_AUTH_BYPASS=false

# Ambiente da aplicação
VITE_AMBIENTE=desenvolvimento

# Dados de teste somente em desenvolvimento
VITE_USE_MOCKS=false
